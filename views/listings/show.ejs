<% layout("/layouts/boilerplate") %>
<div class="col-8 offset-3 mt-3">
  <a href="/listings" class="back-link">
    <i class="fa-solid fa-arrow-left"></i> Back to listings
  </a>
</div>
<div class="row">
  <div class="col-8 offset-3 mt-3 mb-1">
    <h3 class="listing-title">
      <%= listing.title %>
      <% if(listing.category) { %>
        <span class="listing-category-badge"><%= listing.category %></span>
      <% } %>
    </h3>
    <p class="listing-subtitle">
      <i class="fa-solid fa-location-dot"></i>
      <%= listing.location %>, <%= listing.country %>
    </p>
  </div>

  <div class="card col-6 offset-3 show-card listing-card">
    <img
      src="<%=listing.image.url%>"
      class="card-img-top show-img"
      alt="listing_image"
    />
    <div class="card-body">
  <p class="card-text">Owned by <i><b><%= listing.owner.username %></b></i></p>
  <p class="card-text description-text" id="descText">
    <%= listing.description %>
  </p>
  <span class="read-more-toggle" id="readMoreBtn" style="display: none;">Read more</span>
</div>
  </div>

  <div class="col-6 offset-3 mt-3 mb-4">
    <div class="listing-info-grid">
      <div class="info-item">
        <i class="fa-solid fa-location-dot"></i>
        <div>
          <span class="info-label">Location</span>
          <span class="info-value"><%= listing.location %></span>
        </div>
      </div>
      <div class="info-item">
        <i class="fa-solid fa-earth-americas"></i>
        <div>
          <span class="info-label">Country</span>
          <span class="info-value"><%= listing.country %></span>
        </div>
      </div>
      <div class="info-item">
        <i class="fa-solid fa-indian-rupee-sign"></i>
        <div>
          <span class="info-label">Price per night</span>
          <span class="info-value">&#8377; <%= listing.price.toLocaleString("en-IN") %></span>
        </div>
      </div>
    </div>
  </div>

  <br />

  <% if(currUser && listing.owner._id.equals(currUser._id)) { %>
     <div class="btns">
      
     <a href="/listings/<%=listing._id %>/edit"
      class="btn btn-dark col-1 offset-3 edit-btn"
      >Edit</a
      >

    <form method="post" action="/listings/<%=listing._id%>?_method=DELETE">
      <button class="btn btn-dark offset-5">Delete</button>
    </form>
  </div>
  <% } %>
  </div>

  <div class="col-8 offset-3 mb-3">
    <% if(currUser) { %>
      <hr>
    <h4>Leave a Review</h4>
    <form
      action="/listings/<%=listing.id %>/reviews"
      method="post"
      novalidate
      class="needs-validation"
    >

      <div class="mb-3 mt-3">
        <label for="rating" class="form-label">Rating</label>
      <fieldset class="starability-growRotate">
  <input type="radio" id="no-rate" class="input-no-rate" name="review[rating]" value="1" checked aria-label="No rating." />
  <input type="radio" id="first-rate1" name="review[rating]" value="1" />
  <label for="first-rate1" title="Terrible">1 star</label>
  <input type="radio" id="first-rate2" name="review[rating]" value="2" />
  <label for="first-rate2" title="Not good">2 stars</label>
  <input type="radio" id="first-rate3" name="review[rating]" value="3" />
  <label for="first-rate3" title="Average">3 stars</label>
  <input type="radio" id="first-rate4" name="review[rating]" value="4" />
  <label for="first-rate4" title="Very good">4 stars</label>
  <input type="radio" id="first-rate5" name="review[rating]" value="5" />
  <label for="first-rate5" title="Amazing">5 stars</label>
</fieldset>
</div>
      <div class="mb-3 mt-3">
        <label for="comment" class="form-label">Comments</label>
        <textarea
          name="review[comment]"
          id="comment"
          cols="30"
          rows="5"
          class="form-control"
          required
        ></textarea>
        <div class="invalid-feedback">Please add some comments for review</div>
      </div>
      <button class="btn btn-outline-dark">Submit</button>
    </form>
    <hr />
  <% } %>

  <% if(listing.reviews.length > 0) {%>
  <div class="row">
    <p><b>All Reviews</b></p>
    <% for(review of listing.reviews){ %>
      <div class="card col-md-5 mb-3 ms-3 review-card">
        <div class="card-body d-flex align-items-start">
          <div class="profile flex-shrink-0">
            <%= review.author.username.charAt(0).toUpperCase() %>
          </div>
          <div class="review-content ms-3 flex-grow-1">
            <div class="d-flex justify-content-between align-items-start">
              <h5 class="card-title mb-1">@<%= review.author.username %></h5>
              <% if(currUser && review.author._id.equals(currUser._id)) { %>
                <form method="post" action="/listings/<%=listing._id%>/reviews/<%=review._id%>?_method=DELETE">
                  <button class="btn btn-sm review-delete-btn">
                    <i class="fa-solid fa-trash"></i>
                  </button>
                </form>
              <% } %>
            </div>
            <p class="starability-result card-text mb-2" data-rating="<%= review.rating %>"></p>
            <p class="card-text mb-0"><%= review.comment %></p>
          </div>
        </div>
      </div>
    <% } %>
  </div>
<% } %>
  </div>


<div class="col-8 offset-3 mt-2 mb-3">
  <h3>Where you'll be</h3>
  <div class="map-lang-toggle mb-2">
    <button id="langToggleBtn" class="btn btn-sm btn-outline-dark">🌐 Local Language</button>
  </div>
  <div id="map" style="height: 400px; border-radius: 10px;"></div>
</div>

<script>
  const listing = {
    title: `<%- listing.title %>`,
    location: `<%- listing.location %>`,
    geometry: JSON.parse('<%- JSON.stringify(listing.geometry) %>')
  };

  const descEl = document.getElementById("descText");
  const toggleBtn = document.getElementById("readMoreBtn");
  const fullText = descEl.textContent.trim();
  const charLimit = 150;

  if (fullText.length > charLimit) {
    const shortText = fullText.slice(0, charLimit) + "...";
    descEl.textContent = shortText;
    toggleBtn.style.display = "inline-block";

    let expanded = false;
    toggleBtn.addEventListener("click", () => {
      expanded = !expanded;
      descEl.textContent = expanded ? fullText : shortText;
      toggleBtn.textContent = expanded ? "Read less" : "Read more";
    });
  }

</script>
<script src="/js/map.js"></script>